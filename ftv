#!/usr/bin/env python3
"""ftv - Control your Amazon Fire TV via ADB."""

import json
import subprocess
import sys
from datetime import datetime
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "ftv"
CONFIG_FILE = CONFIG_DIR / "config.json"
PORT = 5555

KEYEVENTS = {
    # Navigation
    "up": "KEYCODE_DPAD_UP",
    "down": "KEYCODE_DPAD_DOWN",
    "left": "KEYCODE_DPAD_LEFT",
    "right": "KEYCODE_DPAD_RIGHT",
    "ok": "KEYCODE_DPAD_CENTER",
    "center": "KEYCODE_DPAD_CENTER",
    "back": "KEYCODE_BACK",
    "home": "KEYCODE_HOME",
    "menu": "KEYCODE_MENU",
    # Media
    "play": "KEYCODE_MEDIA_PLAY_PAUSE",
    "fwd": "KEYCODE_MEDIA_FAST_FORWARD",
    "rew": "KEYCODE_MEDIA_REWIND",
    "next": "KEYCODE_MEDIA_NEXT",
    "prev": "KEYCODE_MEDIA_PREVIOUS",
    "volup": "KEYCODE_VOLUME_UP",
    "voldown": "KEYCODE_VOLUME_DOWN",
    "mute": "KEYCODE_VOLUME_MUTE",
    # Keyboard
    "enter": "KEYCODE_ENTER",
    "del": "KEYCODE_DEL",
    # Power
    "on": "KEYCODE_WAKEUP",
    "wake": "KEYCODE_WAKEUP",
    "off": "KEYCODE_SLEEP",
    "sleep": "KEYCODE_SLEEP",
    "toggle": "KEYCODE_POWER",
    "power": "KEYCODE_POWER",
}


def adb(*args, check=True, capture_output=False):
    try:
        return subprocess.run(
            ["adb"] + list(args),
            check=check, capture_output=capture_output, text=True,
        )
    except FileNotFoundError:
        sys.exit("Error: adb not found. Install Android Platform Tools.")


def get_ip():
    try:
        cfg = json.loads(CONFIG_FILE.read_text())
        return cfg.get("ip", "")
    except (FileNotFoundError, json.JSONDecodeError):
        return ""


def save_ip(ip):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps({"ip": ip}, indent=2) + "\n")
    print(f"IP saved: {ip}")


def connected():
    ip = get_ip()
    if not ip:
        return False
    r = adb("devices", capture_output=True, check=False)
    target = f"{ip}:{PORT}"
    return any(target in line and line.rstrip().endswith("\tdevice")
               for line in r.stdout.splitlines())


def ensure_connected():
    ip = get_ip()
    if not ip:
        sys.exit("Error: no IP configured. Use: ftv set-ip <IP>")
    if not connected():
        print(f"Connecting to {ip}:{PORT}...", file=sys.stderr)
        adb("connect", f"{ip}:{PORT}", check=False, capture_output=True)
        if not connected():
            sys.exit(
                f"Error: could not connect to {ip}:{PORT}\n"
                "Make sure the Fire TV is on and ADB Debugging is enabled."
            )


def keyevent(code):
    ensure_connected()
    adb("shell", "input", "keyevent", code)


# ---- subcommands ----

def cmd_connect():
    ip = get_ip()
    if not ip:
        sys.exit("Error: no IP configured. Use: ftv set-ip <IP>")
    adb("connect", f"{ip}:{PORT}")


def cmd_disconnect():
    ip = get_ip()
    if ip:
        adb("disconnect", f"{ip}:{PORT}")
    else:
        adb("disconnect")


def cmd_status():
    adb("devices", "-l")


def cmd_set_ip(ip):
    save_ip(ip)


def cmd_ip():
    ip = get_ip()
    if ip:
        print(f"Configured IP: {ip}")
    else:
        print("No IP configured. Use: ftv set-ip <IP>")
        sys.exit(1)


def cmd_type(text):
    ensure_connected()
    adb("shell", "input", "text", text)


def cmd_screenshot(path=None):
    if path:
        out = path
    else:
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        out = str(Path.home() / "Desktop" / f"firetv_{ts}.png")
    ensure_connected()
    adb("shell", "screencap", "-p", "/sdcard/ftv_shot.png")
    adb("pull", "/sdcard/ftv_shot.png", out)
    adb("shell", "rm", "/sdcard/ftv_shot.png")
    print(f"Screenshot saved to: {out}")


def cmd_launch(pkg):
    ensure_connected()
    # Try monkey first (standard LAUNCHER category)
    r = adb(
        "shell", "monkey", "-p", pkg,
        "-c", "android.intent.category.LAUNCHER", "1",
        capture_output=True, check=False,
    )
    if r.returncode == 0:
        print(f"App {pkg} launched.")
        return
    # monkey failed: resolve MAIN activity and launch with am start
    r = adb(
        "shell", "dumpsys", "package", pkg,
        capture_output=True, check=False,
    )
    import re
    m = re.search(rf"{re.escape(pkg)}/([A-Za-z0-9._]+)", r.stdout)
    if m:
        activity = f"{pkg}/{m.group(1)}"
        adb("shell", "am", "start", "-n", activity, capture_output=True)
        print(f"App {pkg} launched via am start ({activity}).")
        return
    sys.exit(f"Error: could not launch {pkg}. No MAIN activity found.")


def cmd_list(third_only=False):
    ensure_connected()
    args = ["shell", "pm", "list", "packages"]
    if third_only:
        args.append("-3")
    adb(*args)


def cmd_install(apk):
    ensure_connected()
    adb("install", apk)


def cmd_reinstall(apk):
    ensure_connected()
    adb("install", "-r", apk)


def cmd_uninstall(pkg):
    ensure_connected()
    adb("uninstall", pkg)


def cmd_stream(path):
    import http.server
    import os
    import socket

    file = Path(path).resolve()
    if not file.is_file():
        sys.exit(f"Error: {path} not found")
    ensure_connected()
    # Deduce host LAN IP via no-send UDP socket trick
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.connect((get_ip(), 1))
    host_ip = s.getsockname()[0]
    s.close()
    port = 8765  # fixed port, pass as arg if a clash ever happens
    url = f"http://{host_ip}:{port}/stream"
    print(f"Streaming {file.name} to Fire TV...")

    # stdlib SimpleHTTPRequestHandler has no Range support; MKV puts
    # its SeekHead at EOF, so VLC needs partial-content requests to start.
    # Minimal 206 handler below; no 416/validation, VLC never sends bad ranges.
    # URL is fixed to /stream: VLC Android chokes on %-encoded brackets/plus.
    class _RangeHandler(http.server.SimpleHTTPRequestHandler):
        protocol_version = "HTTP/1.1"  # 206 Partial Content requires HTTP/1.1

        def translate_path(self, path):
            return str(file)  # serve the target file regardless of URL

        def send_head(self):
            p = self.translate_path(self.path)
            try:
                f = open(p, "rb")
            except OSError:
                self.send_error(404)
                return None
            size = os.fstat(f.fileno()).st_size
            start, end = 0, size - 1
            rng = self.headers.get("Range")
            if rng and rng.startswith("bytes="):
                s_, e_ = rng[6:].split("-", 1)
                if s_:
                    start = int(s_)
                    end = int(e_) if e_ else size - 1
                else:  # suffix range: last N bytes
                    start = max(0, size - int(e_))
                end = min(end, size - 1)  # clamp: client range may exceed EOF
                self.send_response(206)
                self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
            else:
                self.send_response(200)
            self.send_header("Content-Type", self.guess_type(p))
            self.send_header("Content-Length", str(end - start + 1))
            self.send_header("Accept-Ranges", "bytes")
            self.send_header("Connection", "close")
            self.close_connection = True
            self.end_headers()
            f.seek(start)
            remaining = [end - start + 1]

            class _Lim:  # limit copyfileobj to the requested byte range
                def read(self, n=-1):
                    if remaining[0] <= 0:
                        return b""
                    if n <= 0:
                        n = remaining[0]
                    n = min(n, remaining[0])
                    data = f.read(n)
                    remaining[0] -= len(data)
                    return data
                close = f.close

            return _Lim()

    # kill stale server from a previous run (macOS lsof); without
    # this, rebinding fails with EADDRINUSE after Ctrl+C leaves threads alive.
    subprocess.run(["sh", "-c", f"lsof -ti :{port} | xargs kill -9 2>/dev/null"])
    with http.server.ThreadingHTTPServer(("", port), _RangeHandler) as httpd:
        # Launch VLC AFTER the server is listening, so VLC's first connection
        # doesn't get refused.
        adb("shell", "am", "start", "-a", "android.intent.action.VIEW",
            "-d", url, "-t", "video/*", capture_output=True, check=False)
        print(f"Serving on {url}")
        print("Press Ctrl+C to stop.")
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            pass


HELP = """\
ftv - Control your Amazon Fire TV via ADB

CONNECTION:
  ftv connect               Connect to the Fire TV
  ftv disconnect            Disconnect
  ftv status                Connection status (adb devices)
  ftv set-ip <IP>           Save the Fire TV IP to config
  ftv ip                    Show the configured IP

NAVIGATION (remote control):
  ftv up | down | left | right
  ftv ok                    Center / OK button
  ftv back                  Back
  ftv home                  Home
  ftv menu                  Menu

MEDIA:
  ftv play                  Play/Pause
  ftv fwd                   Fast forward
  ftv rew                   Rewind
  ftv next                  Next track
  ftv prev                  Previous track
  ftv volup                 Volume up
  ftv voldown               Volume down
  ftv mute                  Mute

KEYBOARD:
  ftv type "<text>"         Type text
  ftv enter                 Enter
  ftv del                   Delete

POWER:
  ftv on                    Wake up
  ftv off                   Sleep
  ftv toggle                Toggle power

SCREENSHOT:
  ftv screenshot [path]     Take a screenshot (defaults to ~/Desktop)

APPS:
  ftv launch <package>      Open an app by package name
  ftv list [--third]        List apps (with --third, third-party only)
  ftv install <apk>         Install an APK
  ftv reinstall <apk>       Reinstall, keeping data
  ftv uninstall <package>   Uninstall an app

STREAMING:
  ftv stream <video-file>  Stream a video file to Fire TV via VLC

OTHERS:
  ftv help                  Show this help
"""


def cmd_help():
    print(HELP)


# ---- dispatch ----

def main():
    if len(sys.argv) < 2:
        cmd_help()
        return

    cmd = sys.argv[1]
    args = sys.argv[2:]

    if cmd in KEYEVENTS:
        keyevent(KEYEVENTS[cmd])
    elif cmd == "connect":
        cmd_connect()
    elif cmd == "disconnect":
        cmd_disconnect()
    elif cmd == "status":
        cmd_status()
    elif cmd == "set-ip":
        if not args:
            sys.exit("Usage: ftv set-ip <IP>")
        cmd_set_ip(args[0])
    elif cmd == "ip":
        cmd_ip()
    elif cmd == "type":
        if not args:
            sys.exit('Usage: ftv type "<text>"')
        cmd_type(args[0])
    elif cmd in ("screenshot", "shot"):
        cmd_screenshot(args[0] if args else None)
    elif cmd in ("launch", "open"):
        if not args:
            sys.exit("Usage: ftv launch <package>")
        cmd_launch(args[0])
    elif cmd in ("list", "apps"):
        third = args and args[0] in ("--third", "-3")
        cmd_list(third)
    elif cmd == "install":
        if not args:
            sys.exit("Usage: ftv install <apk-path>")
        cmd_install(args[0])
    elif cmd == "reinstall":
        if not args:
            sys.exit("Usage: ftv reinstall <apk-path>")
        cmd_reinstall(args[0])
    elif cmd == "uninstall":
        if not args:
            sys.exit("Usage: ftv uninstall <package>")
        cmd_uninstall(args[0])
    elif cmd in ("stream", "cast"):
        if not args:
            sys.exit("Usage: ftv stream <video-file>")
        cmd_stream(args[0])
    elif cmd in ("help", "-h", "--help"):
        cmd_help()
    else:
        print(f"Error: unknown subcommand '{cmd}'", file=sys.stderr)
        print("Use 'ftv help' to see available options.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
