#!/usr/bin/env bash
# ftv - Control your Amazon Fire TV via ADB
# Usage: ftv <subcommand> [arguments]
# Config: ~/.config/ftv/config (contains the Fire TV IP)

set -euo pipefail

CONFIG_DIR="${HOME}/.config/ftv"
CONFIG_FILE="${CONFIG_DIR}/config"
PORT=5555

ftv_get_ip() {
  if [[ -f "${CONFIG_FILE}" ]]; then
    head -1 "${CONFIG_FILE}" | tr -d '[:space:]'
  else
    echo ""
  fi
}

ftv_save_ip() {
  local ip="$1"
  mkdir -p "${CONFIG_DIR}"
  echo "${ip}" > "${CONFIG_FILE}"
  echo "IP saved: ${ip}"
}

ftv_connected() {
  local ip
  ip="$(ftv_get_ip)"
  [[ -z "${ip}" ]] && return 1
  adb devices 2>/dev/null | grep -q "${ip}:${PORT}.*device"
}

ftv_ensure_connected() {
  local ip
  ip="$(ftv_get_ip)"
  if [[ -z "${ip}" ]]; then
    echo "Error: no IP configured. Use: ftv set-ip <IP>" >&2
    return 1
  fi
  if ! ftv_connected; then
    echo "Connecting to ${ip}:${PORT}..." >&2
    adb connect "${ip}:${PORT}" >/dev/null 2>&1 || true
    sleep 1
    if ! ftv_connected; then
      echo "Error: could not connect to ${ip}:${PORT}" >&2
      echo "Make sure the Fire TV is on and ADB Debugging is enabled." >&2
      return 1
    fi
  fi
}

ftv_keyevent() {
  ftv_ensure_connected || return 1
  adb shell input keyevent "$1"
}

# ===== Subcommands =====

ftv_connect() {
  local ip
  ip="$(ftv_get_ip)"
  if [[ -z "${ip}" ]]; then
    echo "Error: no IP configured. Use: ftv set-ip <IP>" >&2
    return 1
  fi
  adb connect "${ip}:${PORT}"
}

ftv_disconnect() {
  local ip
  ip="$(ftv_get_ip)"
  if [[ -n "${ip}" ]]; then
    adb disconnect "${ip}:${PORT}"
  else
    adb disconnect
  fi
}

ftv_status() {
  adb devices -l
}

ftv_set_ip() {
  if [[ $# -lt 1 ]]; then
    echo "Usage: ftv set-ip <IP>" >&2
    return 1
  fi
  ftv_save_ip "$1"
}

ftv_ip() {
  local ip
  ip="$(ftv_get_ip)"
  if [[ -n "${ip}" ]]; then
    echo "Configured IP: ${ip}"
  else
    echo "No IP configured. Use: ftv set-ip <IP>"
    return 1
  fi
}

ftv_type() {
  if [[ $# -lt 1 ]]; then
    echo "Usage: ftv type \"<text>\"" >&2
    return 1
  fi
  ftv_ensure_connected || return 1
  adb shell input text "$1"
}

ftv_screenshot() {
  local out
  if [[ $# -ge 1 ]]; then
    out="$1"
  else
    out="${HOME}/Desktop/firetv_$(date +%Y%m%d_%H%M%S).png"
  fi
  ftv_ensure_connected || return 1
  adb shell screencap -p /sdcard/ftv_shot.png \
    && adb pull /sdcard/ftv_shot.png "${out}" \
    && adb shell rm /sdcard/ftv_shot.png \
    && echo "Screenshot saved to: ${out}"
}

ftv_launch() {
  local pkg activity
  if [[ $# -lt 1 ]]; then
    echo "Usage: ftv launch <package>" >&2
    return 1
  fi
  pkg="$1"
  ftv_ensure_connected || return 1
  # Try monkey first (standard LAUNCHER category)
  if adb shell monkey -p "${pkg}" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1; then
    echo "App ${pkg} launched."
    return 0
  fi
  # monkey failed: resolve the MAIN activity and launch with am start
  activity="$(adb shell dumpsys package "${pkg}" 2>/dev/null \
    | grep -A1 'android.intent.action.MAIN' \
    | grep -oE "${pkg}/[A-Za-z0-9._]+" | head -1)"
  if [[ -n "${activity}" ]]; then
    adb shell am start -n "${activity}" >/dev/null 2>&1 \
      && echo "App ${pkg} launched via am start (${activity})." \
      && return 0
  fi
  echo "Error: could not launch ${pkg}. No MAIN activity found." >&2
  return 1
}

ftv_list() {
  ftv_ensure_connected || return 1
  if [[ "${1:-}" == "--third" || "${1:-}" == "-3" ]]; then
    adb shell pm list packages -3
  else
    adb shell pm list packages
  fi
}

ftv_install() {
  if [[ $# -lt 1 ]]; then
    echo "Usage: ftv install <apk-path>" >&2
    return 1
  fi
  ftv_ensure_connected || return 1
  adb install "$1"
}

ftv_reinstall() {
  if [[ $# -lt 1 ]]; then
    echo "Usage: ftv reinstall <apk-path>" >&2
    return 1
  fi
  ftv_ensure_connected || return 1
  adb install -r "$1"
}

ftv_uninstall() {
  if [[ $# -lt 1 ]]; then
    echo "Usage: ftv uninstall <package>" >&2
    return 1
  fi
  ftv_ensure_connected || return 1
  adb uninstall "$1"
}

ftv_help() {
  cat <<'EOF'
ftv - Control your Amazon Fire TV via ADB

CONNECTION:
  ftv connect               Connect to the Fire TV
  ftv disconnect            Disconnect
  ftv status                Connection status (adb devices)
  ftv set-ip <IP>           Save the Fire TV IP to config
  ftv ip                    Show the configured IP

NAVIGATION (remote control):
  ftv up | down | left | right
  ftv ok                    Center / OK button
  ftv back                  Back
  ftv home                  Home
  ftv menu                  Menu

MEDIA:
  ftv play                  Play/Pause
  ftv fwd                   Fast forward
  ftv rew                   Rewind
  ftv next                  Next track
  ftv prev                  Previous track
  ftv volup                 Volume up
  ftv voldown               Volume down
  ftv mute                  Mute

KEYBOARD:
  ftv type "<text>"         Type text
  ftv enter                 Enter
  ftv del                   Delete

POWER:
  ftv on                    Wake up
  ftv off                   Sleep
  ftv toggle                Toggle power

SCREENSHOT:
  ftv screenshot [path]     Take a screenshot (defaults to ~/Desktop)

APPS:
  ftv launch <package>      Open an app by package name
  ftv list [--third]        List apps (with --third, third-party only)
  ftv install <apk>         Install an APK
  ftv reinstall <apk>       Reinstall, keeping data
  ftv uninstall <package>   Uninstall an app

OTHERS:
  ftv help                  Show this help
EOF
}

# ===== Dispatch =====

main() {
  local cmd="${1:-help}"
  shift || true

  case "${cmd}" in
    # Connection
    connect)     ftv_connect "$@" ;;
    disconnect)  ftv_disconnect "$@" ;;
    status)      ftv_status "$@" ;;
    set-ip)      ftv_set_ip "$@" ;;
    ip)          ftv_ip "$@" ;;
    # Navigation
    up)          ftv_keyevent KEYCODE_DPAD_UP ;;
    down)        ftv_keyevent KEYCODE_DPAD_DOWN ;;
    left)        ftv_keyevent KEYCODE_DPAD_LEFT ;;
    right)       ftv_keyevent KEYCODE_DPAD_RIGHT ;;
    ok|center)   ftv_keyevent KEYCODE_DPAD_CENTER ;;
    back)        ftv_keyevent KEYCODE_BACK ;;
    home)        ftv_keyevent KEYCODE_HOME ;;
    menu)        ftv_keyevent KEYCODE_MENU ;;
    # Media
    play)        ftv_keyevent KEYCODE_MEDIA_PLAY_PAUSE ;;
    fwd)         ftv_keyevent KEYCODE_MEDIA_FAST_FORWARD ;;
    rew)         ftv_keyevent KEYCODE_MEDIA_REWIND ;;
    next)        ftv_keyevent KEYCODE_MEDIA_NEXT ;;
    prev)        ftv_keyevent KEYCODE_MEDIA_PREVIOUS ;;
    volup)       ftv_keyevent KEYCODE_VOLUME_UP ;;
    voldown)     ftv_keyevent KEYCODE_VOLUME_DOWN ;;
    mute)        ftv_keyevent KEYCODE_VOLUME_MUTE ;;
    # Keyboard
    type)        ftv_type "$@" ;;
    enter)       ftv_keyevent KEYCODE_ENTER ;;
    del)         ftv_keyevent KEYCODE_DEL ;;
    # Power
    on|wake)     ftv_keyevent KEYCODE_WAKEUP ;;
    off|sleep)   ftv_keyevent KEYCODE_SLEEP ;;
    toggle|power) ftv_keyevent KEYCODE_POWER ;;
    # Screenshot
    screenshot|shot) ftv_screenshot "$@" ;;
    # Apps
    launch|open) ftv_launch "$@" ;;
    list|apps)   ftv_list "$@" ;;
    install)     ftv_install "$@" ;;
    reinstall)   ftv_reinstall "$@" ;;
    uninstall)   ftv_uninstall "$@" ;;
    # Help
    help|-h|--help) ftv_help ;;
    *)
      echo "Error: unknown subcommand '${cmd}'" >&2
      echo "Use 'ftv help' to see available options." >&2
      exit 1
      ;;
  esac
}

main "$@"
