#!/usr/bin/env python3
"""ftv - Control your Amazon Fire TV via ADB."""

import json
import ipaddress
import os
import re
import secrets
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "ftv"
CONFIG_FILE = CONFIG_DIR / "config.json"
PORT = 5555
ADB_TIMEOUT = 30
INSTALL_TIMEOUT = 120

# Module-global IP override for alias-prefixed dispatch. Not thread-safe, but
# the script is single-threaded. Upgrade: pass ip through every cmd_* if we
# ever go concurrent.
_OVERRIDE_IP = None

KEYEVENTS = {
    # Navigation
    "up": "KEYCODE_DPAD_UP",
    "down": "KEYCODE_DPAD_DOWN",
    "left": "KEYCODE_DPAD_LEFT",
    "right": "KEYCODE_DPAD_RIGHT",
    "ok": "KEYCODE_DPAD_CENTER",
    "center": "KEYCODE_DPAD_CENTER",
    "back": "KEYCODE_BACK",
    "home": "KEYCODE_HOME",
    "menu": "KEYCODE_MENU",
    # Media
    "play": "KEYCODE_MEDIA_PLAY_PAUSE",
    "fwd": "KEYCODE_MEDIA_FAST_FORWARD",
    "rew": "KEYCODE_MEDIA_REWIND",
    "next": "KEYCODE_MEDIA_NEXT",
    "prev": "KEYCODE_MEDIA_PREVIOUS",
    "volup": "KEYCODE_VOLUME_UP",
    "voldown": "KEYCODE_VOLUME_DOWN",
    "mute": "KEYCODE_VOLUME_MUTE",
    # Keyboard
    "enter": "KEYCODE_ENTER",
    "del": "KEYCODE_DEL",
    # Power
    "toggle": "KEYCODE_POWER",
    "power": "KEYCODE_POWER",
}


# Commands that target a specific device need `-s <ip:port>`, else adb bails
# with "more than one device/emulator" when several are connected.
_TARGET_CMDS = {"shell", "install", "uninstall", "push", "pull", "reboot"}


def adb(*args, check=True, capture_output=False, timeout=ADB_TIMEOUT):
    if args and args[0] in _TARGET_CMDS:
        ip = get_ip()
        if ip:
            args = ("-s", device_serial(ip)) + args
    try:
        return subprocess.run(
            ["adb"] + list(args),
            check=check, capture_output=capture_output, text=True,
            timeout=timeout,
        )
    except FileNotFoundError:
        sys.exit("Error: adb not found. Install Android Platform Tools.")
    except subprocess.TimeoutExpired:
        sys.exit(f"Error: adb timed out after {timeout} seconds.")
    except subprocess.CalledProcessError as e:
        detail = (e.stderr or e.stdout or "").strip()
        message = f"Error: adb failed with exit code {e.returncode}."
        if detail:
            message += f" {detail}"
        sys.exit(message)
    except OSError as e:
        sys.exit(f"Error: could not execute adb: {e}")


def _empty_cfg():
    return {"devices": {}, "default": None}


def _valid_ip(ip):
    try:
        ipaddress.ip_address(ip)
    except ValueError:
        return False
    return True


def device_serial(ip):
    return f"[{ip}]:{PORT}" if ":" in ip else f"{ip}:{PORT}"


def load_cfg():
    """Read and validate config, migrating legacy {"ip": ...} in memory."""
    try:
        cfg = json.loads(CONFIG_FILE.read_text())
    except FileNotFoundError:
        return _empty_cfg()
    except json.JSONDecodeError as e:
        sys.exit(f"Error: invalid configuration file {CONFIG_FILE}: {e.msg}")
    except OSError as e:
        sys.exit(f"Error: could not read configuration file {CONFIG_FILE}: {e}")
    if not isinstance(cfg, dict):
        sys.exit(f"Error: invalid configuration file {CONFIG_FILE}: expected an object.")
    if "ip" in cfg and "devices" not in cfg:
        # Migrate legacy single-IP config in memory; persisted on next
        # save_device(). Upgrade: drop once all users have migrated.
        cfg = {"devices": {"default": cfg["ip"]}, "default": "default"}
    devices = cfg.get("devices", {})
    if not isinstance(devices, dict):
        sys.exit(f"Error: invalid configuration file {CONFIG_FILE}: devices must be an object.")
    if any(not isinstance(alias, str) or not isinstance(ip, str) or not _valid_ip(ip)
           for alias, ip in devices.items()):
        sys.exit(f"Error: invalid configuration file {CONFIG_FILE}: devices must contain IP addresses.")
    default = cfg.get("default")
    if default is not None and not isinstance(default, str):
        sys.exit(f"Error: invalid configuration file {CONFIG_FILE}: default must be a device alias.")
    cfg["devices"] = devices
    cfg["default"] = default if default in devices else next(iter(devices), None)
    return cfg


def save_cfg(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(cfg, indent=2) + "\n")


def get_ip():
    if _OVERRIDE_IP:
        return _OVERRIDE_IP
    cfg = load_cfg()
    alias = cfg.get("default")
    if not alias:
        return ""
    return cfg["devices"].get(alias, "")


def save_device(alias, ip, make_default=True):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,31}", alias):
        sys.exit("Error: alias must contain only letters, numbers, hyphens, or underscores.")
    if not _valid_ip(ip):
        sys.exit(f"Error: '{ip}' is not a valid IP address.")
    cfg = load_cfg()
    cfg["devices"][alias] = ip
    if make_default and not cfg.get("default"):
        cfg["default"] = alias
    save_cfg(cfg)
    print(f"Saved {alias}: {ip}" + (" (default)" if cfg["default"] == alias else ""))


def connected():
    ip = get_ip()
    if not ip:
        return False
    r = adb("devices", capture_output=True, check=False)
    target = device_serial(ip)
    return any(target in line and line.rstrip().endswith("\tdevice")
               for line in r.stdout.splitlines())


def ensure_connected():
    ip = get_ip()
    if not ip:
        sys.exit("Error: no IP configured. Use: ftv set-ip <IP>")
    if not connected():
        print(f"Connecting to {ip}:{PORT}...", file=sys.stderr)
        adb("connect", device_serial(ip), check=False, capture_output=True)
        if not connected():
            sys.exit(
                f"Error: could not connect to {ip}:{PORT}\n"
                "Make sure the Fire TV is on and ADB Debugging is enabled."
            )


def keyevent(code):
    ensure_connected()
    adb("shell", "input", "keyevent", code)


# on/off force a sleep↔wake transition so the Fire TV's HDMI control fires
# CEC: WAKEUP when already awake = no CEC (no OTP to TV); SLEEP when already
# asleep = no CEC (no power-down to TV). So we check wakefulness first and
# force the opposite transition only when needed, avoiding TV flicker.
# KEYCODE_TV_POWER is dead on Fire OS. Deep sleep may drop ADB-WiFi; pre-connect
# is best-effort, if it fails the device is out of ADB reach (hardware limit).
def _wakefulness():
    r = adb("shell", "dumpsys", "power", capture_output=True, check=False)
    for line in r.stdout.splitlines():
        line = line.strip()
        if line.startswith("mWakefulness="):
            return line.split("=", 1)[1]
    return "Unknown"


def cmd_on():
    ip = get_ip()
    if not ip:
        sys.exit("Error: no IP configured. Use: ftv set-ip <IP>")
    adb("connect", device_serial(ip), check=False, capture_output=True)
    if _wakefulness() == "Awake":
        keyevent("KEYCODE_SLEEP")  # force transition: WAKEUP alone sends no CEC
        time.sleep(1)
    keyevent("KEYCODE_WAKEUP")
    time.sleep(0.5)
    keyevent("KEYCODE_HOME")
    print(f"Fire TV: {_wakefulness().lower()}")


def cmd_off():
    if not get_ip():
        sys.exit("Error: no IP configured. Use: ftv set-ip <IP>")
    if _wakefulness() == "Asleep":
        keyevent("KEYCODE_WAKEUP")  # force transition: SLEEP alone sends no CEC
        time.sleep(1)
    keyevent("KEYCODE_SLEEP")
    print(f"Fire TV: {_wakefulness().lower()}")


# ---- subcommands ----

def cmd_connect():
    ip = get_ip()
    if not ip:
        sys.exit("Error: no IP configured. Use: ftv set-ip <IP>")
    adb("connect", device_serial(ip))


def cmd_disconnect():
    ip = get_ip()
    if ip:
        adb("disconnect", device_serial(ip))
    else:
        adb("disconnect")


def cmd_status():
    adb("devices", "-l")


def cmd_set_ip(ip):
    # Backward compat: set-ip => add default + use default.
    if not _valid_ip(ip):
        sys.exit(f"Error: '{ip}' is not a valid IP address.")
    cfg = load_cfg()
    cfg["devices"]["default"] = ip
    cfg["default"] = "default"
    save_cfg(cfg)
    print(f"IP saved: {ip}")


def cmd_ip():
    cfg = load_cfg()
    # Derive the active alias from override or cfg.default; both index into
    # cfg["devices"]. Override path only matters for alias-prefixed dispatch.
    alias = _OVERRIDE_IP and next(
        (a for a, ip in cfg["devices"].items() if ip == _OVERRIDE_IP),
        cfg.get("default"),
    ) or cfg.get("default")
    ip = get_ip()
    if ip:
        label = f" ({alias})" if alias and alias != "default" else ""
        print(f"Configured IP: {ip}{label}")
    else:
        print("No IP configured. Use: ftv add <alias> <IP>  (or: ftv set-ip <IP>)")
        sys.exit(1)


# ---- device management ----

RESERVED = set(KEYEVENTS) | {
    "connect", "disconnect", "status", "set-ip", "ip",
    "type", "screenshot", "shot", "launch", "open", "list", "apps",
    "install", "reinstall", "uninstall", "stream", "cast",
    "help", "-h", "--help",
    "add", "devices", "use", "rm",
    "on", "wake", "off", "sleep",
}


def cmd_add(alias, ip):
    if alias in RESERVED:
        sys.exit(f"Error: alias '{alias}' conflicts with a subcommand.")
    save_device(alias, ip)


def cmd_devices():
    cfg = load_cfg()
    devs = cfg.get("devices", {})
    if not devs:
        print("No devices configured. Use: ftv add <alias> <IP>")
        return
    default = cfg.get("default")
    for alias, ip in devs.items():
        mark = " *" if alias == default else ""
        print(f"{alias:<12} {ip}{mark}")
    print(f"\n* = default")


def cmd_use(alias):
    cfg = load_cfg()
    if alias not in cfg["devices"]:
        sys.exit(f"Error: no such device '{alias}'. Use: ftv devices")
    cfg["default"] = alias
    save_cfg(cfg)
    print(f"Default set to {alias} ({cfg['devices'][alias]})")


def cmd_rm(alias):
    cfg = load_cfg()
    if alias not in cfg["devices"]:
        sys.exit(f"Error: no such device '{alias}'. Use: ftv devices")
    del cfg["devices"][alias]
    if cfg.get("default") == alias:
        cfg["default"] = next(iter(cfg["devices"]), None)
    save_cfg(cfg)
    print(f"Removed {alias}")


def cmd_type(text):
    ensure_connected()
    adb("shell", "input", "text", text)


def cmd_screenshot(path=None):
    ts = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
    if path:
        out = path
    else:
        out = str(Path.home() / "Desktop" / f"firetv_{ts}.png")
    remote = f"/sdcard/ftv_shot_{ts}_{os.getpid()}.png"
    ensure_connected()
    adb("shell", "screencap", "-p", remote)
    try:
        adb("pull", remote, out)
    finally:
        adb("shell", "rm", remote, check=False, capture_output=True)
    print(f"Screenshot saved to: {out}")


def cmd_launch(pkg):
    ensure_connected()
    # Try monkey first (standard LAUNCHER category)
    r = adb(
        "shell", "monkey", "-p", pkg,
        "-c", "android.intent.category.LAUNCHER", "1",
        capture_output=True, check=False,
    )
    if r.returncode == 0 and "No activities found" not in r.stdout:
        print(f"App {pkg} launched.")
        return
    # monkey failed: ask the package manager for the actual MAIN activity.
    r = adb(
        "shell", "cmd", "package", "resolve-activity", "--brief",
        "-a", "android.intent.action.MAIN", "-p", pkg,
        capture_output=True, check=False,
    )
    m = re.search(rf"^{re.escape(pkg)}/[A-Za-z0-9_.$]+$", r.stdout, re.MULTILINE)
    if m:
        activity = m.group(0)
        adb("shell", "am", "start", "-n", activity, capture_output=True)
        print(f"App {pkg} launched via am start ({activity}).")
        return
    sys.exit(f"Error: could not launch {pkg}. No MAIN activity found.")


def cmd_list(third_only=False):
    ensure_connected()
    args = ["shell", "pm", "list", "packages"]
    if third_only:
        args.append("-3")
    adb(*args)


def cmd_install(apk):
    ensure_connected()
    adb("install", apk, timeout=INSTALL_TIMEOUT)


def cmd_reinstall(apk):
    ensure_connected()
    adb("install", "-r", apk, timeout=INSTALL_TIMEOUT)


def cmd_uninstall(pkg):
    ensure_connected()
    adb("uninstall", pkg)


def cmd_stream(path, port=8765):
    import http.server
    import socket

    file = Path(path).resolve()
    if not file.is_file():
        sys.exit(f"Error: {path} not found")
    ensure_connected()
    # Deduce host LAN IP via no-send UDP socket trick
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.connect((get_ip(), 1))
    host_ip = s.getsockname()[0]
    s.close()
    token = secrets.token_urlsafe(24)
    stream_path = f"/stream/{token}"
    url = f"http://{host_ip}:{port}{stream_path}"
    print(f"Streaming {file.name} to Fire TV...")

    # stdlib SimpleHTTPRequestHandler has no Range support; MKV puts its
    # SeekHead at EOF, so VLC needs partial-content requests to start.
    # Minimal single-range handler with a tokenized URL for LAN access control.
    class _RangeHandler(http.server.SimpleHTTPRequestHandler):
        protocol_version = "HTTP/1.1"  # 206 Partial Content requires HTTP/1.1

        def copyfile(self, source, outputfile):
            try:
                super().copyfile(source, outputfile)
            except (BrokenPipeError, ConnectionResetError):
                pass

        def translate_path(self, path):
            return str(file)  # serve the target file regardless of URL

        def send_head(self):
            if self.path.split("?", 1)[0] != stream_path:
                self.send_error(404)
                return None
            p = self.translate_path(self.path)
            try:
                f = open(p, "rb")
            except OSError:
                self.send_error(404)
                return None
            size = os.fstat(f.fileno()).st_size
            start, end = 0, size - 1
            rng = self.headers.get("Range")
            if rng:
                try:
                    if not rng.startswith("bytes=") or "," in rng:
                        raise ValueError
                    s_, e_ = rng[6:].split("-", 1)
                    if s_:
                        start = int(s_)
                        end = int(e_) if e_ else size - 1
                    else:  # suffix range: last N bytes
                        length = int(e_)
                        if length <= 0:
                            raise ValueError
                        start = max(0, size - length)
                    if start < 0 or start >= size or end < start:
                        raise ValueError
                except ValueError:
                    f.close()
                    self.send_response(416)
                    self.send_header("Content-Range", f"bytes */{size}")
                    self.end_headers()
                    return None
                end = min(end, size - 1)  # clamp: client range may exceed EOF
                self.send_response(206)
                self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
            else:
                self.send_response(200)
            self.send_header("Content-Type", self.guess_type(p))
            self.send_header("Content-Length", str(end - start + 1))
            self.send_header("Accept-Ranges", "bytes")
            self.send_header("Connection", "close")
            self.close_connection = True
            self.end_headers()
            f.seek(start)
            remaining = [end - start + 1]

            class _Lim:  # limit copyfileobj to the requested byte range
                def read(self, n=-1):
                    if remaining[0] <= 0:
                        return b""
                    if n <= 0:
                        n = remaining[0]
                    n = min(n, remaining[0])
                    data = f.read(n)
                    remaining[0] -= len(data)
                    return data
                close = f.close

            return _Lim()

    try:
        httpd = http.server.ThreadingHTTPServer((host_ip, port), _RangeHandler)
    except OSError as e:
        sys.exit(f"Error: cannot start stream server on {host_ip}:{port}: {e}")
    with httpd:
        # Force-stop VLC first: a stale VLC process can't reinitialize its
        # NativeWindow video surface, causing instant crash on replay.
        adb("shell", "am", "force-stop", "org.videolan.vlc",
            capture_output=True, check=False)
        time.sleep(0.5)
        # Launch VLC AFTER the server is listening, so VLC's first connection
        # doesn't get refused.
        adb("shell", "am", "start", "-a", "android.intent.action.VIEW",
            "-d", url, "-t", "video/*", capture_output=True, check=False)
        print(f"Serving on {url}")
        print("Press Ctrl+C to stop.")
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            pass


HELP = """\
ftv - Control your Amazon Fire TV via ADB

DEVICES:
  ftv add <alias> <IP>       Add (or update) a Fire TV
  ftv devices                List configured devices (* = default)
  ftv use <alias>            Set the default device
  ftv rm <alias>             Remove a device
  ftv <alias> <command>      Run any command on a specific device
                             e.g. ftv bedroom up

CONNECTION:
  ftv connect               Connect to the default Fire TV
  ftv disconnect            Disconnect
  ftv status                Connection status (adb devices)
  ftv set-ip <IP>           Save IP as the default device (legacy)
  ftv ip                    Show the default device's IP

NAVIGATION (remote control):
  ftv up | down | left | right
  ftv ok                    Center / OK button
  ftv back                  Back
  ftv home                  Home
  ftv menu                  Menu

MEDIA:
  ftv play                  Play/Pause
  ftv fwd                   Fast forward
  ftv rew                   Rewind
  ftv next                  Next track
  ftv prev                  Previous track
  ftv volup                 Volume up
  ftv voldown               Volume down
  ftv mute                  Mute

KEYBOARD:
  ftv type "<text>"         Type text
  ftv enter                 Enter
  ftv del                   Delete

POWER:
  ftv on                    Wake up (+ CEC: turns on the TV via HDMI control)
  ftv off                   Sleep (+ CEC: powers down the TV via HDMI control)
  ftv toggle                Toggle power

SCREENSHOT:
  ftv screenshot [path]     Take a screenshot (defaults to ~/Desktop)

APPS:
  ftv launch <package>      Open an app by package name
  ftv list [--third]        List apps (with --third, third-party only)
  ftv install <apk>         Install an APK
  ftv reinstall <apk>       Reinstall, keeping data
  ftv uninstall <package>   Uninstall an app

STREAMING:
  ftv stream <video-file> [port]
                           Stream a video file to Fire TV via VLC

OTHERS:
  ftv help                  Show this help
"""


def cmd_help():
    print(HELP)


# ---- dispatch ----

def main():
    global _OVERRIDE_IP

    if len(sys.argv) < 2:
        cmd_help()
        return

    cmd = sys.argv[1]
    args = sys.argv[2:]

    # Alias prefix: if argv[1] is a known device and not a reserved
    # subcommand, target that device and dispatch argv[2:].
    if cmd not in RESERVED:
        cfg = load_cfg()
        if cmd in cfg.get("devices", {}):
            _OVERRIDE_IP = cfg["devices"][cmd]
            cmd = args[0] if args else ""
            args = args[1:]
            if not cmd:
                sys.exit(f"Usage: ftv {sys.argv[1]} <command> [args]")

    if cmd in KEYEVENTS:
        keyevent(KEYEVENTS[cmd])
    elif cmd in ("on", "wake"):
        cmd_on()
    elif cmd in ("off", "sleep"):
        cmd_off()
    elif cmd == "connect":
        cmd_connect()
    elif cmd == "disconnect":
        cmd_disconnect()
    elif cmd == "status":
        cmd_status()
    elif cmd == "set-ip":
        if not args:
            sys.exit("Usage: ftv set-ip <IP>")
        cmd_set_ip(args[0])
    elif cmd == "ip":
        cmd_ip()
    elif cmd == "add":
        if len(args) < 2:
            sys.exit("Usage: ftv add <alias> <IP>")
        cmd_add(args[0], args[1])
    elif cmd == "devices":
        cmd_devices()
    elif cmd == "use":
        if not args:
            sys.exit("Usage: ftv use <alias>")
        cmd_use(args[0])
    elif cmd == "rm":
        if not args:
            sys.exit("Usage: ftv rm <alias>")
        cmd_rm(args[0])
    elif cmd == "type":
        if not args:
            sys.exit('Usage: ftv type "<text>"')
        cmd_type(args[0])
    elif cmd in ("screenshot", "shot"):
        cmd_screenshot(args[0] if args else None)
    elif cmd in ("launch", "open"):
        if not args:
            sys.exit("Usage: ftv launch <package>")
        cmd_launch(args[0])
    elif cmd in ("list", "apps"):
        third = args and args[0] in ("--third", "-3")
        cmd_list(third)
    elif cmd == "install":
        if not args:
            sys.exit("Usage: ftv install <apk-path>")
        cmd_install(args[0])
    elif cmd == "reinstall":
        if not args:
            sys.exit("Usage: ftv reinstall <apk-path>")
        cmd_reinstall(args[0])
    elif cmd == "uninstall":
        if not args:
            sys.exit("Usage: ftv uninstall <package>")
        cmd_uninstall(args[0])
    elif cmd in ("stream", "cast"):
        if not args:
            sys.exit("Usage: ftv stream <video-file> [port]")
        port = 8765
        if len(args) > 1:
            try:
                port = int(args[1])
            except ValueError:
                sys.exit("Error: port must be a number between 1 and 65535.")
            if not 1 <= port <= 65535:
                sys.exit("Error: port must be between 1 and 65535.")
        cmd_stream(args[0], port)
    elif cmd in ("help", "-h", "--help"):
        cmd_help()
    else:
        print(f"Error: unknown subcommand '{cmd}'", file=sys.stderr)
        print("Use 'ftv help' to see available options.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
